# ─────────────────────────────────────────────────────────────────────────────
# AI Agentic Assistant — Environment Variables
# Copy to .env and fill in real values before running locally or deploying.
# NEVER commit .env to git.
# FIXED: Replaced all real API keys with safe placeholders
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LangSmith tracing ─────────────────────────────────────────────────────────
LANGCHAIN_API_KEY=lsv2_pt_replace-with-your-langsmith-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ai-agentic-assistant

# ── Tavily web search ─────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-replace-with-your-tavily-api-key

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Local dev:      bolt://localhost:7687
# Docker Compose: bolt://aaa_neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-strong-neo4j-password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev:      redis://localhost:6379
# Docker Compose: redis://aaa_redis:6379
REDIS_URL=redis://localhost:6379
# Required in production (must match docker-compose.prod.yml REDIS_PASSWORD)
REDIS_PASSWORD=replace-with-strong-redis-password

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_PATH=./data/chroma_db

# ── FAISS ─────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index

# ── RAG chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Ollama (local LLM fallback) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── MLflow ────────────────────────────────────────────────────────────────────
# Local dev: ./data/mlflow_runs   Docker: http://aaa_mlflow:5001
MLFLOW_TRACKING_URI=./data/mlflow_runs

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-32-char-minimum-random-secret

# ── API settings ──────────────────────────────────────────────────────────────
API_RATE_LIMIT=60
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173"]

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:replace-password@localhost:5432/agentic_v2
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_v2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# ── External services ─────────────────────────────────────────────────────────
# Playwright browser service (docker-compose: http://aaa_playwright:8010)
PLAYWRIGHT_SERVICE_URL=http://localhost:8010
# Coqui TTS service (docker-compose: http://aaa_coqui_tts:5002)
COQUI_TTS_URL=http://localhost:5002

# ── Memory (Mem0) ─────────────────────────────────────────────────────────────
# Leave empty for self-hosted Mem0, or paste m0-... for Mem0 cloud
MEM0_API_KEY=
MEMORY_MAX_TOKENS=500
MEMORY_RETRIEVAL_LIMIT=10

# ── Domain Verticals ─────────────────────────────────────────────────────────
# DevOps vertical
GITHUB_TOKEN=ghp_replace-with-your-github-token
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=replace-with-your-jira-api-token

# Research vertical — uses ArXiv/PubMed public APIs + existing Tavily + RAG
# No additional keys needed

# Analyst vertical — uses existing PostgreSQL
# Optionally point to a separate analytics DB:
# ANALYTICS_POSTGRES_URL=postgresql://...

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 1 — Guardian Agent (Compliance)
# ═══════════════════════════════════════════════════════════════════════════════
# No additional keys needed — uses existing OpenAI + PostgreSQL

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 6 — HITL Approval Notifications
# ═══════════════════════════════════════════════════════════════════════════════
SENDGRID_API_KEY=SG.replace-with-your-sendgrid-api-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/your-webhook-url
HITL_REVIEWER_EMAIL=reviewer@your-org.com
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 4 — Agentic Task Scheduler
# ═══════════════════════════════════════════════════════════════════════════════
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 5 & 8 — Commerce + Billing (Stripe / Razorpay)
# ═══════════════════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-stripe-publishable-key
RAZORPAY_KEY_ID=rzp_test_replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 5, 13 — Twilio (SMS / WhatsApp / Voice)
# ═══════════════════════════════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 5 — DocuSign (e-signatures)
# ═══════════════════════════════════════════════════════════════════════════════
DOCUSIGN_INTEGRATION_KEY=replace-with-your-docusign-integration-key
DOCUSIGN_ACCOUNT_ID=replace-with-your-docusign-account-id
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 9 — AgriTech
# ═══════════════════════════════════════════════════════════════════════════════
OPENWEATHER_API_KEY=replace-with-your-openweathermap-api-key

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 10 — Indian Legal Research
# ═══════════════════════════════════════════════════════════════════════════════
INDIANKANOON_API_KEY=replace-with-your-indiankanoon-api-key

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 15 — AI Email Manager (OAuth)
# ═══════════════════════════════════════════════════════════════════════════════
GMAIL_CLIENT_ID=replace-with-your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-your-gmail-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/email/oauth/gmail/callback
OUTLOOK_CLIENT_ID=replace-with-your-azure-app-client-id
OUTLOOK_CLIENT_SECRET=replace-with-your-azure-app-client-secret
OUTLOOK_TENANT_ID=common

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 16 — AI Sales Assistant / CRM
# ═══════════════════════════════════════════════════════════════════════════════
HUBSPOT_API_KEY=replace-with-your-hubspot-private-app-token
SALESFORCE_CLIENT_ID=replace-with-your-salesforce-connected-app-client-id
SALESFORCE_CLIENT_SECRET=replace-with-your-salesforce-connected-app-secret
CLEARBIT_API_KEY=replace-with-your-clearbit-api-key

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 19 — AI Social Media Manager
# ═══════════════════════════════════════════════════════════════════════════════
BUFFER_ACCESS_TOKEN=replace-with-your-buffer-access-token
TWITTER_BEARER_TOKEN=replace-with-your-twitter-bearer-token
TWITTER_API_KEY=replace-with-your-twitter-api-key
TWITTER_API_SECRET=replace-with-your-twitter-api-secret
TWITTER_ACCESS_TOKEN=replace-with-your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=replace-with-your-twitter-access-token-secret
LINKEDIN_ACCESS_TOKEN=replace-with-your-linkedin-access-token
INSTAGRAM_ACCESS_TOKEN=replace-with-your-instagram-graph-api-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=replace-with-your-instagram-business-id
# LinkedIn UGC author URN (urn:li:person:xxxx or urn:li:organization:xxxx)
LINKEDIN_AUTHOR_URN=urn:li:person:replace-with-your-linkedin-person-id

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 5 — Calendly + DocuSign (additions)
# ═══════════════════════════════════════════════════════════════════════════════
CALENDLY_API_KEY=replace-with-your-calendly-personal-access-token
DOCUSIGN_ACCESS_TOKEN=replace-with-your-docusign-jwt-bearer-access-token

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 16 — Salesforce REST API
# ═══════════════════════════════════════════════════════════════════════════════
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
SALESFORCE_ACCESS_TOKEN=replace-with-your-salesforce-oauth-access-token

# ═══════════════════════════════════════════════════════════════════════════════
# Feature 12 — A/B Testing (Ollama for open-source models)
# ═══════════════════════════════════════════════════════════════════════════════
# OLLAMA_BASE_URL already set above — used for llama3 / mistral A/B experiments
